APP_NAME="Enterprise ERP Suite"
APP_SHORT_NAME="ERP Suite"
APP_SERVICE_NAME="erp-saas-api"
APP_DOMAIN="yourdomain.com"
FRONTEND_URL="https://yourdomain.com"
CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000"
PORT=5000
NODE_ENV=production
JSON_BODY_LIMIT=80mb
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/erp_saas?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-secret"
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_BUCKET="your-r2-bucket"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_PUBLIC_BASE_URL="https://files.yourdomain.com"
# CLOUDFLARE_R2_S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# CLOUDFLARE_R2_JURISDICTION="eu"
