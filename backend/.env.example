# Cloudflare R2 (S3-compatible credentials)
# You can use either CLOUDFLARE_R2_* names or compatible aliases supported by uploads route.

CLOUDFLARE_R2_BUCKET=aimhygienics-files
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Optional: if you use a custom public domain for files
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://files.aimhygienics.com
